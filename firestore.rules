rules_version = '2';

// Firebase konsolu -> Firestore Database -> Rules sekmesine yapıştırıp Publish et.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Herkese açık profil: yalnızca görünen ad. Liste çekmek yasak, tek tek okunabilir.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // E-posta -> kullanıcı kimliği eşlemesi (arkadaşı e-postayla bulmak için).
    // Liste çekmek yasak: yalnızca tam e-posta adresini bilen kişi sorgulayabilir.
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /trips/{tripId} {
      // Geziyi yalnızca üyeleri okuyabilir
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'currency', 'ownerId', 'memberIds', 'at'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.currency in ['₺', '€', '$', '£']
        && request.resource.data.at is int;

      allow update: if signedIn() && (
        // Sahibi: yalnızca üye listesini değiştirebilir (ekle/çıkar)
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 30)
        ||
        // Diğer üyeler: yalnızca kendilerini çıkarabilir
        (request.auth.uid in resource.data.memberIds
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.toSet() ==
             resource.data.memberIds.toSet().difference([request.auth.uid].toSet()))
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /expenses/{expId} {
        function trip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        function validExpense(d) {
          return d.keys().hasOnly(['desc', 'amount', 'payerId', 'amongIds', 'by', 'at'])
            && d.desc is string && d.desc.size() > 0 && d.desc.size() <= 60
            && d.amount is int && d.amount > 0 && d.amount <= 100000000000
            && d.payerId in trip().memberIds
            && d.amongIds is list && d.amongIds.size() > 0
            && d.amongIds.toSet().difference(trip().memberIds.toSet()).size() == 0
            && d.by is string
            && d.at is int;
        }

        allow read: if signedIn() && request.auth.uid in trip().memberIds;

        allow create: if signedIn()
          && request.auth.uid in trip().memberIds
          && request.resource.data.by == request.auth.uid
          && validExpense(request.resource.data);

        // Harcamayı ekleyen kişi ya da gezi sahibi düzenleyebilir
        allow update: if signedIn()
          && request.auth.uid in trip().memberIds
          && (resource.data.by == request.auth.uid || trip().ownerId == request.auth.uid)
          && request.resource.data.by == resource.data.by
          && validExpense(request.resource.data);

        allow delete: if signedIn()
          && (resource.data.by == request.auth.uid || trip().ownerId == request.auth.uid);
      }
    }
  }
}
